# ============================================================
#  Нормализация line endings
#  В репозитории всегда LF, на диске — по правилам ниже
# ============================================================
* text=auto eol=lf

# ============================================================
#  Windows-специфичные файлы — CRLF
# ============================================================
*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.props   text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# ============================================================
#  Unix-скрипты — LF
# ============================================================
*.sh      text eol=lf
*.bash    text eol=lf

# ============================================================
#  Бинарные файлы — не трогать
# ============================================================
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.7z    binary